# bkdb settings shared by every dump sidecar of this app.
# Copy to bkdb.env next to the app's docker-compose.yml and reference it with
# `env_file: bkdb.env`. Database connection settings belong in the service's
# `environment:` (see compose.yml.example), not here.

# --- notifications (Telegram) ------------------------------------------------
# No token = no notifications.
TG_BOT_TOKEN=123456:ABC-replace-me
TG_CHAT_ID=123456789
# Prefix in messages, e.g. "homeserver/immich". Default: container hostname.
HOST_LABEL=homeserver
# failure (default) | always | never
#NOTIFY=failure

# Instead of TG_BOT_TOKEN, read the token from a file (Docker secrets):
#TG_BOT_TOKEN_FILE=/run/secrets/tg_bot_token

# --- schedule ------------------------------------------------------------------
# Time zone SCHEDULE is evaluated in. Default: UTC.
TZ=Europe/Berlin
# Crontab expression; @daily etc. also work. Default: 0 3 * * *
#SCHEDULE=30 2 * * *
# Also dump once right after the container starts. Default: false
#RUN_ON_START=false

# --- output ----------------------------------------------------------------------
# Dumps kept in /backup, including the latest. Default: 3
#KEEP=3
# Permissions of created dump files. Default: 022
#UMASK=022
